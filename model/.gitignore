# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Downloaded / generated datasets and synthetic images
data/*
!data/.gitkeep

# Evaluation results and model artifacts
results/*
!results/.gitkeep
# The derived evaluation outputs the report cites as measurements.
# They are small, deterministic, and are the audit trail for every
# figure the report quotes, so they are tracked rather than ignored.
!results/derived/
!results/derived/*.json
*.onnx
*.pt
*.safetensors
*.bin
*.pkl
*.ct2/