# Copy to `.env` (same folder) and fill in. Never commit `.env` — it is gitignored.
# Shell scripts source it automatically; python entry points load it via
# goat_model.utils.load_dotenv(). Real exported variables always win.

# Hugging Face token (gated datasets). Empty works for public repos only.
HF_TOKEN=

# Webhook URL for run notifications (host watchdog + error pings). Empty disables.
DISCORD_WEBHOOK_URL=

# Set to 1 for verbose per-action logs without passing --debug.
GOAT_DEBUG=
