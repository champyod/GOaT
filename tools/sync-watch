#!/usr/bin/env python3
"""sync-watch: pull a VM training log and watch it, all in one process.

Each poll: fetch bytes past the remote offset via ``colab exec``, append
to OUT, then run the watchdog over the fresh bytes only — error/done
scanning, per-poll heartbeat with last-progress echo, silence warning at
``--silence`` and really-down error at ``--downtime``. Discord embeds
role-ping on error/done/warning/downtime. Never exits; Ctrl+C to stop.
Sync misses (colab failure) and VM silence stay separate: a stalled sync
gates the host alerts instead of faking them.

Usage:
    export DISCORD_WEBHOOK_URL=...  # or model/.env, or --webhook
    python tools/sync-watch --vm-log /tmp/goat_training_log.txt --session goat \
        --out ~/synced/goat.log --silence 900 --downtime 3600 --poll 15
    # --vm-log has no default (required); --out defaults to ~/synced/goat.log.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

try:  # pipeline logging when run inside the model tree
    from goat_model.log import error as _err
    from goat_model.log import info as _info
    from goat_model.log import warning as _warn
except ImportError:  # standalone copy (e.g. Pi): same call shape, plain stdout

    def _info(tag: str, msg: object = "", **kv: object) -> None:
        tail = " ".join(f"{k}={v}" for k, v in kv.items())
        print(f"INFO {tag} {msg} {tail}".rstrip(), flush=True)

    def _warn(tag: str, msg: object = "", **kv: object) -> None:
        tail = " ".join(f"{k}={v}" for k, v in kv.items())
        print(f"WARNING {tag} {msg} {tail}".rstrip(), flush=True)

    def _err(tag: str, msg: object = "", **kv: object) -> None:
        tail = " ".join(f"{k}={v}" for k, v in kv.items())
        print(f"ERROR {tag} {msg} {tail}".rstrip(), flush=True)


ROLE = "1498710581547634930"

REMOTE_PY = """\
import os
path = os.environ["SYNC_WATCH_VM_LOG"]
off = int(os.environ.get("SYNC_WATCH_OFF", "0"))
try:
    size = os.path.getsize(path)
except OSError as e:
    print(f"[sync-miss] {e}")
else:
    if size < off:
        off = 0
    try:
        with open(path, "rb") as f:
            f.seek(off)
            data = f.read()
    except OSError as e:
        print(f"[sync-miss] {e}")
    else:
        print(f"SYNC_WATCH_SIZE={size}")
        print(data.decode("utf-8", "replace"), end="")
"""


def _send(webhook: str, text: str, title: str = "GOaT", color: int = 0x5865F2, ping: bool = False) -> None:
    if not webhook:
        return
    import datetime
    try:
        payload = {
            "content": f"<@&{ROLE}>" if ping else "",
            "allowed_mentions": {"parse": ["roles"]},
            "embeds": [{
                "title": title,
                "description": text[:4000],
                "color": color,
                "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            }],
        }
        req = urllib.request.Request(
            webhook,
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type": "application/json", "User-Agent": "goat-watchdog/1.0"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            resp.read()
    except Exception as err:
        _warn("sync-watch", f"notify failed: {err}")


def _load_dotenv() -> None:
    """Load model/.env (KEY=VALUE) into environ; real exports win. Stdlib-only."""
    cands = [Path.cwd() / ".env", Path(__file__).resolve().parent.parent / ".env"]
    for extra in os.environ.get("GOAT_ENV", "").split(":") if os.environ.get("GOAT_ENV") else []:
        cands.append(Path(extra))
    for cand in cands:
        try:
            text = cand.read_text(encoding="utf-8")
        except OSError:
            continue
        for raw in text.splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, val = line.partition("=")
            key = key.strip()
            val = val.strip().strip("'").strip('"')
            if key and key not in os.environ:
                os.environ[key] = val


def _matches_any(line: str, patterns: list[str]) -> str | None:
    lowered = line.lower()
    for pattern in patterns:
        if pattern.lower() in lowered:
            return pattern
    return None


def _fmt_age(seconds: float) -> str:
    """Human age like 45s, 2m 3s, 1h 5m for idle/sync displays."""
    total = max(0, int(seconds))
    hours, rem = divmod(total, 3600)
    mins, secs = divmod(rem, 60)
    if hours:
        return f"{hours}h {mins}m"
    if mins:
        return f"{mins}m {secs}s"
    return f"{secs}s"


def _heartbeat_state(*, finished: bool, last_event: str | None) -> str:
    if finished:
        return "done, watching"
    if last_event == "error":
        return "stuck at error, waiting for recovery"
    return "healthy"


def _read_int(path: Path) -> int:
    try:
        return max(0, int(path.read_text(encoding="utf-8").strip()))
    except (OSError, ValueError):
        return 0


def _fetch(*, session: str, vm_log: str, offset: int, colab_bin: str,
           timeout: float) -> tuple[str, int | None, bool]:
    """Pull bytes past offset. Returns (data, remote_size, reached).

    reached=False only when colab itself failed (then data/size are empty).
    A missing VM log still counts as reached: the binding works, the file
    just isn't there yet.
    """
    try:
        proc = subprocess.run(
            [colab_bin, "exec", "-s", session],
            input=REMOTE_PY.encode(),
            capture_output=True,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as err:
        _warn("sync-watch", f"fetch miss: {err}")
        return "", None, False
    lines = [ln for ln in proc.stdout.decode("utf-8", "replace").splitlines()
             if not ln.startswith("[colab]")]
    if proc.returncode != 0 or not lines:
        detail = proc.stderr.decode("utf-8", "replace").strip()[:200]
        _warn("sync-watch", f"fetch miss rc={proc.returncode}", detail=detail)
        return "", None, False
    if lines[0].startswith("[sync-miss]"):
        _warn("sync-watch", f"vm log absent: {lines[0][:200]}")
        return "", None, True
    match = re.match(r"SYNC_WATCH_SIZE=(\d+)$", lines[0])
    if not match:
        _warn("sync-watch", "fetch miss: bad protocol", detail=lines[0][:200])
        return "", None, False
    return "\n".join(lines[1:]), int(match.group(1)), True


def _ingest_chunk(chunk: str, *, job: str, webhook: str, error_patterns: list[str],
                  done_patterns: list[str], reported: set[str]) -> tuple[str | None, str | None, bool]:
    """Scan fresh bytes (logs + Discord as side effects). Returns (last_progress, event, finished)."""
    progress: str | None = None
    event: str | None = None
    finished = False
    for line in chunk.splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        progress = re.sub(r"^\S+ (?:INFO|WARNING|ERROR) ", "", stripped).strip() or stripped
        hit = _matches_any(line, error_patterns)
        if hit is not None and line not in reported:
            reported.add(line)
            event = "error"
            _err("sync-watch", line.strip()[:200], match=hit)
            _send(webhook, f"{job} ERROR ({hit}): {line.strip()[:1000]}", title="Training ERROR", color=0xFF0000, ping=True)
            continue
        if _matches_any(line, done_patterns) is not None:
            finished = True
            _info("sync-watch", line.strip()[:200], state="done")
            _send(webhook, f"{job} done", title="Training done", color=0x00FF00, ping=True)
    return progress, event, finished


def main() -> int:
    parser = argparse.ArgumentParser(description="Pull a VM training log and watch it in one process.")
    parser.add_argument("--session", default="goat", help="colab session name")
    parser.add_argument("--vm-log", required=True, help="training log path on the VM (no default)")
    parser.add_argument("--out", type=Path, default=Path("~/synced/goat.log"),
                        help="local synced copy (default: ~/synced/goat.log)")
    parser.add_argument("--offset-file", type=Path, default=None,
                        help="remote byte offset store (default: <out>.offset)")
    parser.add_argument("--webhook", default="", help="webhook URL (or DISCORD_WEBHOOK_URL env)")
    parser.add_argument("--job", default="goat", help="job label used in Discord messages")
    # NOTE: bare "oom" (matches "room"), "inf" (matches "info") and "nan"
    # (matches "finance") deliberately excluded; covered by "out of memory",
    # "=inf" and "=nan" instead.
    parser.add_argument("--error-pattern", action="append",
                        default=["traceback", "error", "exception", "fail", "fatal",
                                 "abort", "killed", "out of memory", "cuda out of memory",
                                 "illegal memory access", "segmentation fault", "segfault",
                                 "core dumped", "timeout", "timed out", "connection refused",
                                 "connection reset", "permission denied", "no space left",
                                 "read-only file system", "panic", "uncaught", "crash",
                                 "=nan", "=inf"],
                        help="repeatable substring (case-insensitive) signalling failure")
    parser.add_argument("--done-pattern", action="append",
                        default=["done", "finish", "complet", "success"],
                        help="repeatable substring signalling clean finish")
    parser.add_argument("--silence", type=float, default=600.0,
                        help="seconds without growth = may-be-down warning (latched, never exits)")
    parser.add_argument("--downtime", type=float, default=3600.0,
                        help="seconds without growth = really-down error (latched, never exits; must exceed --silence)")
    parser.add_argument("--poll", type=float, default=15.0, help="poll interval seconds")
    parser.add_argument("--colab-bin", default="colab", help="colab CLI binary")
    parser.add_argument("--exec-timeout", type=float, default=60.0, help="seconds per colab exec call")
    args = parser.parse_args()

    _load_dotenv()
    webhook = args.webhook or os.environ.get("DISCORD_WEBHOOK_URL", "")
    out = args.out.expanduser()
    out.parent.mkdir(parents=True, exist_ok=True)
    out.touch(exist_ok=True)
    offset_file = args.offset_file.expanduser() if args.offset_file else Path(str(out) + ".offset")
    offset = _read_int(offset_file)
    size = out.stat().st_size
    start = time.monotonic()
    last_sync_ok = start
    last_sync_wall = time.time()
    last_growth = start
    last_progress: str | None = None
    last_event: str | None = None  # "error" | "ok": status of the last reported chunk
    finished = False
    warned = down_alerted = sync_warned = False
    if args.downtime <= args.silence:
        _warn("sync-watch", "downtime alert disabled, must exceed silence",
              downtime=args.downtime, silence=args.silence)
        args.downtime = float("inf")
    reported: set[str] = set()
    _info("sync-watch", f"watching {out} <- {args.session}:{args.vm_log}",
          silence=args.silence, downtime=args.downtime, poll=args.poll)
    _send(webhook, f"watching {args.job} started", title="Watch started", color=0x5865F2)

    while True:  # never exits on its own; Ctrl+C to stop
        time.sleep(args.poll)
        data, remote_size, reached = _fetch(
            session=args.session, vm_log=args.vm_log, offset=offset,
            colab_bin=args.colab_bin, timeout=args.exec_timeout)
        if reached:
            last_sync_ok = time.monotonic()
            last_sync_wall = time.time()
            if remote_size is not None and remote_size < offset:
                _warn("sync-watch", "vm log rotated, restarting local copy")
                out.write_bytes(b"")
                size = 0
                offset = 0
            if data:
                with open(out, "a", encoding="utf-8") as fh:
                    fh.write(data if data.endswith("\n") else data + "\n")
                size = out.stat().st_size
                if remote_size is not None:
                    offset = remote_size
                    offset_file.write_text(str(offset), encoding="utf-8")
                last_growth = time.monotonic()
                warned = down_alerted = False
                progress, event, done = _ingest_chunk(
                    data, job=args.job, webhook=webhook,
                    error_patterns=args.error_pattern, done_patterns=args.done_pattern,
                    reported=reported)
                if progress is not None:
                    last_progress = progress
                if event is not None:
                    last_event = event
                elif not done:
                    if last_event == "error":
                        _info("sync-watch", "recovered, job alive again")
                    last_event = "ok"
                finished = finished or done
        idle = time.monotonic() - last_growth
        sync_idle = time.monotonic() - last_sync_ok
        sync_at = time.strftime("%H:%M:%S", time.localtime(last_sync_wall))
        state = _heartbeat_state(finished=finished, last_event=last_event)
        if last_progress is not None:
            _info("sync-watch", state, idle=_fmt_age(idle), size=size,
                  sync_idle=_fmt_age(sync_idle), sync_at=sync_at, last=last_progress[:200])
        else:
            _info("sync-watch", state, idle=_fmt_age(idle), size=size,
                  sync_idle=_fmt_age(sync_idle), sync_at=sync_at)
        sync_fresh = sync_idle < args.silence
        if not sync_fresh:
            if not sync_warned:
                sync_warned = True
                _warn("sync-watch", "sync stalled, host state unknown", idle=_fmt_age(idle))
            continue
        sync_warned = False
        if finished or last_event == "error":
            continue  # silence after done/crash is expected; never alert, never exit
        if idle >= args.downtime and not down_alerted:
            down_alerted = True
            warned = True
            _err("sync-watch", "host is down", idle=_fmt_age(idle), downtime=_fmt_age(args.downtime))
            _send(webhook, f"{args.job} DOWN {_fmt_age(idle)} - host is down", title="Host down", color=0xFF0000, ping=True)
        elif idle >= args.silence and not warned:
            warned = True
            _warn("sync-watch", "host may be down", idle=_fmt_age(idle), silence=_fmt_age(args.silence))
            _send(webhook, f"{args.job} MAYBE-DOWN {_fmt_age(idle)} - host may be down", title="Host may be down", color=0xFFA500, ping=True)


if __name__ == "__main__":
    sys.exit(main())
