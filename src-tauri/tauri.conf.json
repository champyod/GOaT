{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "GOaT",
  "version": "0.1.0",
  "identifier": "com.goat.app",
  "build": {
    "beforeDevCommand": "bun --cwd app run dev",
    "beforeBuildCommand": "bun --cwd app run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../app/build"
  },
  "app": {
    "windows": [
      {
        "title": "GOaT",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
