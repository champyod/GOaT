{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GOaT",
  "version": "0.1.0",
  "identifier": "com.goat.app",
  "build": {
    "beforeDevCommand": "bun run --cwd app dev",
    "beforeBuildCommand": "bun run --cwd app build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../app/build"
  },
  "app": {
    "windows": [
      {
        "title": "GOaT",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true
      },
      {
        "label": "setup",
        "title": "GOaT Setup",
        "url": "/setup",
        "width": 480,
        "height": 560,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false
      },
      {
        "label": "errors",
        "title": "GOaT Errors",
        "url": "/errors",
        "width": 520,
        "height": 400,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/tesseract-ocr"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
